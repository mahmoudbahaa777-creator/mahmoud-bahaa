# Cloudflare Pages caching. Hashed build files never change, so phones can keep them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=2592000
/logos/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
